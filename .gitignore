# ── Server credentials and signing material: never commit any of this ────────
# Public Firebase *client* config is fine and lives in
# packages/*/lib/firebase_options.dart. Everything below is the other side of
# that boundary. `scripts/check-no-secrets.mjs` fails CI if any of it is
# committed anyway with `git add -f`, because .gitignore alone is not evidence.
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
.runtimeconfig.json
google-service-account.json
.env
.env.*
!.env.example
*.jks
*.keystore
*.p12
*.p8
*.mobileprovision
key.properties
android/key.properties
packages/*/android/key.properties

# ── Firebase CLI local state ─────────────────────────────────────────────────
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log
database-debug.log
ui-debug.log
pubsub-debug.log
*.local

# ── Dart / Flutter ───────────────────────────────────────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
.pub-cache/
.pub/
**/doc/api/
*.iml
*.ipr
*.iws
.idea/
# Generated by `melos bootstrap`; regenerated on every bootstrap.
pubspec_overrides.yaml

# ── Node ─────────────────────────────────────────────────────────────────────
node_modules/
packages/functions/lib/
npm-debug.log*
.eslintcache

# ── Build evidence is produced by CI and uploaded as an artifact ─────────────
build-evidence/

# ── OS / editor ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
.vscode/

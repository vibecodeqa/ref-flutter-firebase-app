{
  "$comment": [
    "Firebase project configuration for the flutter-firebase-app reference implementation.",
    "Emulator ports are pinned explicitly rather than left to defaults so that CI, local",
    "development and the rules tests all agree, and so that concurrent agents/services on",
    "the same machine do not collide."
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "packages/functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" ci",
        "npm --prefix \"$RESOURCE_DIR\" run typecheck",
        "npm --prefix \"$RESOURCE_DIR\" test",
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ],
      "ignore": [
        "node_modules",
        ".git",
        "src/**/*.test.ts",
        "*.local"
      ]
    }
  ],
  "hosting": [
    {
      "target": "app",
      "public": "packages/app/build/web",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
          ]
        }
      ]
    },
    {
      "target": "admin",
      "public": "packages/admin/build/web",
      "ignore": ["**/.*", "**/node_modules/**"],
      "rewrites": [{ "source": "**", "destination": "/index.html" }],
      "headers": [
        {
          "source": "**",
          "headers": [
            { "key": "X-Content-Type-Options", "value": "nosniff" },
            { "key": "X-Frame-Options", "value": "DENY" },
            { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
            { "key": "Cache-Control", "value": "no-store" }
          ]
        }
      ]
    }
  ],
  "emulators": {
    "auth": { "port": 9099, "host": "127.0.0.1" },
    "firestore": { "port": 8080, "host": "127.0.0.1" },
    "functions": { "port": 5211, "host": "127.0.0.1" },
    "hosting": { "port": 5210, "host": "127.0.0.1" },
    "storage": { "port": 9199, "host": "127.0.0.1" },
    "ui": { "enabled": false, "port": 4020 },
    "singleProjectMode": true
  }
}
